  m_Name: 
  m_EditorClassIdentifier: Pickleball.Runtime::Pickleball.Sandbox.Boss.Hypatia.HypatiaBoss
  config: {fileID: 11400000, guid: 621b5f38936634d48a7eeba8a6feb48c, type: 2}
  arenaCentre: {fileID: 690657481}
  player: {fileID: 1195753252314885893}
  playerHealth: {fileID: 1195753252314885902}
