  m_Name: Birdy_Intro
  m_EditorClassIdentifier: Pickleball.Runtime::Pickleball.Sandbox.Dialogue.DialogueDefinition
  id: birdy.intro
  speakerName: Birdy
  startNodeId: start
  nodes:
  - id: start
    kind: 2
    text: 
    emote: 0
    next: back.promised
    options: []
    conditions:
    - kind: 0
      key: birdy.promised_help
      value:
